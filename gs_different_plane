def fraunhofer_fft(U0, pitch, wavelength, z_list): # size of logo dependent on z; but only counts in fraunhofer field
    # z(F) = 2D**2 / wavelength; D = N * pitch
    # -> bigger illuminated DOE -> bigggger Fraunhofer distance 
    N_y, N_x = U0.shape
    # FFT of DOE-plane field
    U_far = np.fft.fftshift(np.fft.fft2(U0))
    I_far = np.abs(U_far)**2
    # FFT of spatial freq in cycles/meter
    fx = np.fft.fftshift(np.fft.fftfreq(N_x, d=pitch))
    fy = np.fft.fftshift(np.fft.fftfreq(N_y, d=pitch))
    for z in z_list:
         # Fraunhofer mapping: x = z * lambda * fx
        x_mm = z * wavelength * fx * 1e3
        y_mm = z * wavelength * fy * 1e3
        X_mm, Y_mm = np.meshgrid(x_mm, y_mm)
        plt.pcolormesh(X_mm, Y_mm, I_far, shading="auto", cmap="inferno")
        plt.xlabel("x / mm")
        plt.ylabel("y / mm")
        plt.axis("equal")
        plt.title(f"Fraunhofer far field, z = {z*1e3:.3f} mm")
        plt.colorbar(label="Intensity (a.u.)")
        plt.show()

