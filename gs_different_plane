def angular_spectrum(U0, pitch, wavelength, z):
    ny, nx = U0.shape
    fx = np.fft.fftfreq(nx, d=pitch)
    fy = np.fft.fftfreq(ny, d=pitch)
    FX, FY = np.meshgrid(fx, fy)

    k = 2*np.pi/wavelength
    root = np.sqrt(1 - (wavelength*FX)**2 - (wavelength*FY)**2 + 0j)
    H = np.exp(1j * k * z * root)

    Uz = np.fft.ifft2(np.fft.fft2(U0) * H)
    return Uz


