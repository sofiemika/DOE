# Write a function replace_amplitude(U, A_new) that keeps
# the phase of U but sets its magnitude to A_new:
def replace_amplitude(U, A_new):
    # extract phase angle from field U:
    phase = np.angle(U)
    # combine new amplitude with original phase info:
    U_new = A_new * np.exp(1j * phase)
    return U_new

# FFT tools:
def propagate(U):
    U_uncentered = np.fft.ifftshift(U)
    V_raw = np.fft.fft2(U_uncentered, norm="ortho") #norm="ortho" makes it unitary
    V_centered = np.fft.fftshift(V_raw)
    return V_centered

def backpropagate(V):
    V_uncentered = np.fft.ifftshift(V)
    U_raw = np.fft.ifft2(V_uncentered, norm="ortho")
    U_centered = np.fft.fftshift(U_raw)
    return U_centered

# Intensity from amplitude:
def intensity(A):
    I = np.abs(A)**2
    return I

