def f_farfield_pixel_size(wave, focal_length, x_in, N=512): 
    # function to calculate far-field pixel size based on wavelength, focal length, number of pixels, and input pixel size
    f_x_out = (wave * focal_length) / (N * x_in)
    # defines function
    return f_x_out
    # returns the calculated far-field pixel size

