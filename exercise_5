def propagate_U_int(U):
    U_source = U
    V_far_raw = np.fft.fft2(U_source, norm="ortho") #norm="ortho" makes it unitary
    V_far_shift = np.fft.fftshift(V_far_raw)
    I_far = np.abs(V_far_shift)**2
    return I_far

def propagate(U):
    U_uncentered = np.fft.ifftshift(U)
    V_raw = np.fft.fft2(U_uncentered, norm="ortho") #norm="ortho" makes it unitary
    V_centered = np.fft.fftshift(V_raw)
    return V_centered

def backpropagate(V):
    V_uncentered = np.fft.ifftshift(V)
    U_raw = np.fft.ifft2(V_uncentered, norm="ortho")
    U_centered = np.fft.fftshift(U_raw)
    return U_centered

