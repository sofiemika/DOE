def plot_both(a, b):
    #plot:
    fig, axs = plt.subplots(1, 2, figsize=(14, 5))

    # Left Panel: Raw FFT output
    axs[0].plot(a, color='crimson', linewidth=2)
    axs[0].set_title("Raw Magnitude Spectrum (`np.fft.fft`)")
    axs[0].set_xlabel("Frequency Index")
    axs[0].set_ylabel("Absolute Amplitude")
    axs[0].grid(True, linestyle='--', alpha=0.6)

    # Right Panel: Shifted FFT output (Standard sinc profile representation)
    axs[1].plot(b, color='dodgerblue', linewidth=2)
    axs[1].set_title("Centered Magnitude Spectrum (`np.fft.fftshift`)")
    axs[1].set_xlabel("Centered Frequency Index")
    axs[1].set_ylabel("Absolute Amplitude")
    axs[1].grid(True, linestyle='--', alpha=0.6)

    plt.tight_layout()
    plt.show()

