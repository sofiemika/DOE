# Far field of a flat beam. Propagate the Gaussian with zero 
# phase to the far field and plot intensity |U|². Check:
# single small spot in the centre - a lens focusing a beam.

def phi_zero(N):
    phi_zero = np.zeros((N,N))
    return phi_zero

def U_source(A, phi):
    U = A * np.exp(1j * phi)
    return U

